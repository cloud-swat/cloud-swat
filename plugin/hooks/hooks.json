{
  "hooks": {
    "SessionStart":     [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/swat-hook.js\"", "timeout": 6 } ] } ],
    "UserPromptSubmit": [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/swat-hook.js\"", "timeout": 5 } ] } ],
    "PreToolUse":       [ { "matcher": "*", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/swat-hook.js\"", "timeout": 5 } ] } ],
    "PostToolUse":      [ { "matcher": "Task|Agent", "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/swat-hook.js\"", "timeout": 5 } ] } ],
    "SubagentStop":     [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/swat-hook.js\"", "timeout": 5 } ] } ],
    "Stop":             [ { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/swat-hook.js\"", "timeout": 5 } ] } ]
  }
}
